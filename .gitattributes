# 换行统一：文本文件入库自动归一为 LF
* text=auto

# Windows PowerShell 脚本：必须是 CRLF（PowerShell 5.1 对 LF 的 .ps1 容错差，
# 且 check.ps1 / verify.ps1 的中文输出依赖本地代码页行为）
*.ps1 text eol=lf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 跨平台文本：LF
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# 二进制，不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.tgz binary
*.zip binary
